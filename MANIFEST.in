include package.json package-lock.json update.json README.md README.ru.md LICENSE DISCLAIMER.md ASSETS.md RELEASE_NOTES.md
recursive-include bin *.js
recursive-include server *.js
recursive-include extension *.js *.html *.css *.json *.png
recursive-include docs *.md
recursive-include scripts *.js
recursive-include python/src *.py
prune node_modules
prune .local
prune dist
prune test
prune .git
