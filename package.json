{
  "name": "codex-browser-bridge",
  "version": "0.8.1",
  "description": "Control Chromium and Firefox from Codex through a local MCP and extension bridge",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server/mcp.js",
    "bridge": "node server/daemon.js",
    "status": "node scripts/status.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "fixture": "node scripts/fixture.js",
    "package": "node scripts/package.js",
    "icons": "node scripts/icons.js",
    "test:handoff": "node scripts/handoff-smoke.js",
    "test:firefox": "node scripts/firefox-smoke.js",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --ignore-files manifest.firefox.json",
    "test:isolated": "node scripts/isolated-browser-smoke.js",
    "doctor": "node scripts/doctor.js",
    "remote": "node server/remote.js",
    "github:configure": "node scripts/github-setup.js",
    "pack:npm": "node scripts/build-npm.js",
    "pack:python": "python3 -m pip wheel . --no-build-isolation --no-deps --wheel-dir dist",
    "test:python": "python3 -m unittest discover -s python/tests -v",
    "test:packages": "python3 scripts/test-packages.py"
  },
  "keywords": [
    "codex",
    "mcp",
    "browser-automation",
    "firefox",
    "brave",
    "chromium",
    "webextension",
    "virtual-media",
    "remote-browser"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "bin": {
    "codex-browser-bridge": "bin/codex-browser-bridge.js"
  },
  "files": [
    "bin/",
    "server/",
    "extension/",
    "scripts/setup.js",
    "scripts/doctor.js",
    "scripts/status.js",
    "scripts/fixture.js",
    "scripts/native-setup.js",
    "scripts/native-host.js",
    "scripts/export-extension.js",
    "docs/",
    "update.json",
    "README.ru.md",
    "DISCLAIMER.md",
    "scripts/lifecycle.js",
    "ASSETS.md",
    "RELEASE_NOTES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dariumi/codex-browser-bridge.git"
  },
  "homepage": "https://github.com/dariumi/codex-browser-bridge",
  "bugs": {
    "url": "https://github.com/dariumi/codex-browser-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
