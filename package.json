{
  "name": "codex-browser-bridge",
  "version": "0.4.0",
  "description": "Control your existing Chromium browser from Codex through a local MCP and extension bridge",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server/mcp.js",
    "bridge": "node server/daemon.js",
    "status": "node scripts/status.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "fixture": "node scripts/fixture.js",
    "package": "node scripts/package.js",
    "icons": "node scripts/icons.js",
    "test:handoff": "node scripts/handoff-smoke.js",
    "test:firefox": "node scripts/firefox-smoke.js",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --ignore-files manifest.firefox.json",
    "test:isolated": "node scripts/isolated-browser-smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
