{
  "manifest_version": 3,
  "name": "Codex Browser Bridge",
  "version": "0.4.0",
  "description": "Connect your existing browser tabs to your local Codex MCP server.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "notifications",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/avatar-16.png",
    "32": "assets/avatar-32.png",
    "48": "assets/avatar-48.png",
    "128": "assets/avatar-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Codex Browser Bridge",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/avatar-128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  },
  "sidebar_action": {
    "default_title": "Codex",
    "default_panel": "chat.html",
    "default_icon": "assets/avatar-32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "codex-browser-bridge@dariumi",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
